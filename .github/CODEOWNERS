# GoreeCloud Vault Server review ownership
#
# GoreeCloud Vault Server is maintained by GoreeCloud. The Vaultwarden-derived
# runtime is transitional and upstream maintainers are not automatically
# responsible for reviewing GoreeCloud-specific changes.

# Repository automation, policy, release, security, and current product identity
/.github/** @GoreeCloud
/README.md @GoreeCloud
/VAULT.md @GoreeCloud
/BRANDING.md @GoreeCloud
/SECURITY.md @GoreeCloud
/CONTRIBUTING.md @GoreeCloud
/goreecloud.platform.yaml @GoreeCloud
/.trivyignore.yaml @GoreeCloud
/docs/** @GoreeCloud

# Dependency and build inputs
/Cargo.toml @GoreeCloud
/Cargo.lock @GoreeCloud
/rust-toolchain.toml @GoreeCloud
/build.rs @GoreeCloud
/Dockerfile @GoreeCloud
/Dockerfile.j2 @GoreeCloud
/DockerSettings.yaml @GoreeCloud
/docker/** @GoreeCloud
/deploy/** @GoreeCloud

# Transitional server runtime, including authentication, cryptography,
# authorization, persistence, SSO, rate limiting, configuration, and server UI.
/src/** @GoreeCloud
/migrations/** @GoreeCloud

# Temporary GoreeCloud Vault Web incubation boundary. This directory must move
# to a dedicated current-name client repository before Stable promotion.
/web-client/** @GoreeCloud

# Proposed long-term native GoreeCloud Vault Server boundary.
/native/** @GoreeCloud

# Release-blocking compatibility, recovery, migration, deployment, security,
# repository-readiness, naming, and Glaze UI conformance harnesses.
/tests/** @GoreeCloud
/scripts/** @GoreeCloud
